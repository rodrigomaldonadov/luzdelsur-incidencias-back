# =====================================================================
# Variables de entorno del despliegue. Copiar como .env y cambiar secretos.
#   cp .env.example .env
#   chmod 600 .env
# =====================================================================

# --- Dominio y TLS ---------------------------------------------------
DOMAIN=localhost
APP_PUBLIC_URL=https://localhost
APP_CORS_ALLOWED_ORIGINS=https://localhost,http://localhost:5173

# --- PostgreSQL ------------------------------------------------------
POSTGRES_DB=incidencias
POSTGRES_USER=incidencias
POSTGRES_PASSWORD=CAMBIAR_CLAVE_LARGA_Y_ALEATORIA
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

# --- Imagenes --------------------------------------------------------
BACKEND_IMAGE=luzdelsur/incidencias-backend:latest
# Contexto del repositorio de Persona 5 (FastAPI + sentence-transformers)
EMBEDDINGS_CONTEXT=../embeddings
EMBEDDINGS_IMAGE=luzdelsur/embeddings:latest
EMBEDDINGS_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# --- Motor heuristico ------------------------------------------------
GROUPING_WINDOW_MINUTES=30
GROUPING_MAX_CANDIDATES=5

# --- Microservicio de embeddings ------------------------------------
EMBEDDINGS_ENABLED=true
EMBEDDINGS_TIMEOUT_MS=1500
EMBEDDINGS_COOLDOWN_SECONDS=30
EMBEDDINGS_MATCH_THRESHOLD=0.55
EMBEDDINGS_CONFLICT_THRESHOLD=0.30

# --- Backend ---------------------------------------------------------
# TEMPORAL hasta que Persona 3 implemente JWT:
# rol por defecto cuando el cliente no envia X-Actor-Role.
APP_DEV_DEFAULT_ROLE=CLIENTE
SPRINGDOC_ENABLED=false
APP_LOG_LEVEL=INFO
JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport"

# Compose de backend + PostgreSQL externo. Copiar como .env.

BACKEND_PORT=8080
BACKEND_IMAGE=luzdelsur/incidencias-backend:latest

# PostgreSQL externo (no se levanta un contenedor de base de datos)
DB_URL=jdbc:postgresql://HOST:5435/incidencias
DB_USER=incidencias
DB_PASSWORD=CAMBIAR_CLAVE
DB_POOL_SIZE=10
DB_POOL_MIN_IDLE=2

APP_PUBLIC_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173

# JWT (Persona 3): secreto fijo de al menos 32 caracteres. Sin el, cada
# reinicio genera uno nuevo y invalida las sesiones del frontend.
APP_JWT_SECRET=CAMBIAR_SECRETO_DE_AL_MENOS_32_CARACTERES
APP_JWT_ISSUER=luzdelsur-incidencias
APP_JWT_ACCESS_TTL_MINUTES=60
APP_JWT_REFRESH_TTL_DAYS=7
APP_AUTH_ALLOW_STAFF_REGISTRATION=false

# Cuentas demo: operador@luzdelsur.com.pe, tecnico@luzdelsur.com.pe,
# tecnico2@luzdelsur.com.pe y cliente@luzdelsur.com.pe.
APP_DEMO_PASSWORD=CAMBIAR_CLAVE_DEMO
APP_DEMO_SEED_USERS=true
APP_DEMO_SEED_REPORTS=true

# false en produccion; true solo para probar con X-Actor-* desde Swagger.
APP_ALLOW_DEV_HEADERS=false
APP_DEV_DEFAULT_ROLE=CLIENTE

GROUPING_WINDOW_MINUTES=30
GROUPING_MAX_CANDIDATES=5

EMBEDDINGS_ENABLED=false
EMBEDDINGS_BASE_URL=http://host.docker.internal:8000

SPRINGDOC_ENABLED=false
APP_LOG_LEVEL=INFO
JAVA_OPTS="-XX:MaxRAMPercentage=75 -XX:+UseContainerSupport"

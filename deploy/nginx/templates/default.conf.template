# Plantilla procesada por la imagen oficial de nginx (envsubst).
# Solo se sustituyen variables de entorno definidas; las variables de nginx
# ($host, $remote_addr, etc.) permanecen intactas.

upstream backend_upstream {
    server backend:8080;
    keepalive 16;
}

# ---------- HTTP: desafio ACME + redireccion a HTTPS ----------
server {
    listen 80;
    listen [::]:80;
    server_name ${DOMAIN};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------- HTTPS ----------
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${DOMAIN};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_prefer_server_ciphers off;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;

    client_max_body_size 1m;

    # Monitoreo externo controlado (no expone detalles internos).
    location = /health {
        proxy_pass http://backend_upstream/actuator/health;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Evita exponer metricas, env o configuracion de Spring.
    location /actuator {
        return 404;
    }

    # Alta de reportes: limite mas estricto contra abuso.
    location = /api/v1/reports {
        limit_req zone=report_zone burst=10 nodelay;
        proxy_pass http://backend_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /api/ {
        limit_req zone=api_zone burst=20 nodelay;
        proxy_pass http://backend_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    # Documentacion interactiva. En produccion mantener SPRINGDOC_ENABLED=false.
    location = /swagger-ui.html {
        proxy_pass http://backend_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /docs {
        proxy_pass http://backend_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /swagger-ui/ {
        proxy_pass http://backend_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location /v3/api-docs {
        proxy_pass http://backend_upstream;
        include /etc/nginx/snippets/proxy.conf;
    }

    location = / {
        default_type application/json;
        return 200 '{"service":"gestion-incidencias","status":"up"}';
    }

    location / {
        return 404;
    }
}
